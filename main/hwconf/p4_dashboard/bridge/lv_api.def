/* lv_api.def -- LVGL functions visible from LispBM.
 *
 * One line = one function:   F(RET, lv_c_name, ARG, ARG, ...)
 * Lisp name = C name with '_' replaced by '-'   (lv_obj_set_pos -> lv-obj-set-pos)
 *
 * Add a function:  python3 bridge/tools/gen_api.py --lvgl <lvgl>/src add lv_xxx
 * (or write the line by hand; kinds are described in gen_api.py / lvbr.h).
 * Lines are grouped per widget so that a widget disabled in lv_conf.h simply
 * drops out of the build. Nothing else has to be edited.
 */

